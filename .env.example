# Supabase (project settings > API). Leave blank to run on the sample catalogue.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Paystack (dashboard > settings > API keys). Leave blank for demo reservations.
PAYSTACK_SECRET_KEY=

# Public site URL, used for Paystack callback links
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# WhatsApp business number in international format, digits only
NEXT_PUBLIC_WHATSAPP_NUMBER=2340000000000
